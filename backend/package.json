{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
    "start": "NODE_ENV=production node dist/index.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prismo/shared": "*",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.15.2",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.24.0",
    "eslint": "^9",
    "tsx": "^4.19.1",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
