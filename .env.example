# Optional overrides for the local dev stack (./dev.sh).
# Copy to `.env` — nothing here is required, the defaults work out of the box.

# Host ports. Change these if something else on your machine owns them.
WEB_PORT=3000
BACKEND_PORT=4000
MONGO_PORT=27017
MQTT_PORT=1883
MONGO_VIEWER_PORT=5000
POSTGRES_PORT=5432
POSTGRES_VIEWER_PORT=5050

# Local sign-in uses a mock Google account so no OAuth setup is needed.
# To test the real Google flow instead, set this to an empty value and fill in
# the credentials below.
# DEV_MOCK_LOGIN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
