# Only needed when running the app outside Docker (`npm run dev` on the host).
# The Docker stack (`./dev.sh` from the repo root) sets all of these for you.

MONGODB_URL=mongodb://localhost:27017/prismo?directConnection=true&replicaSet=rs0
MONGODB_DATABASE=prismo
MQTT_URL=mqtt://admin:admin@localhost:1883

SESSION_SECRET=dev-secret-not-for-production
ORIGIN=http://localhost:3000

# MQTT admin credentials the app uses to provision devices
USERNAME=admin
PASSWORD=admin

# Mock Google sign-in so no OAuth credentials are needed locally.
# Comment out and fill in the two values below to use the real Google flow.
TEST_MODE=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
