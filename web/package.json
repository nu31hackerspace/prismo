		"@tailwindcss/vite": "^4.1.18",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/qrcode": "^1.5.6",
		"devalue": "^5.7.1",
		"mdsvex": "^0.12.6",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
